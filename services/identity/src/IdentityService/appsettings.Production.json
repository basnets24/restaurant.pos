{
  "ServiceSettings": {
    "Authority": "https://identity.spoontab.com"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://spoontab.com",
      "https://www.spoontab.com"
    ]
  },
  "IdentityServerSettings": {
    "Clients": [
      {
        "ClientId": "frontend",
        "AllowedGrantTypes": [
          "authorization_code"
        ],
        "RequireClientSecret": false,
        "RedirectUris": [
          "https://spoontab.com/authentication/login-callback",
          "https://www.spoontab.com/authentication/login-callback",
          "https://spoontab.com/silent-renew.html",
          "https://www.spoontab.com/silent-renew.html"
        ],
        "PostLogoutRedirectUris": [
          "https://spoontab.com/authentication/logout-callback",
          "https://www.spoontab.com/authentication/logout-callback"
        ],
        "AllowedCorsOrigins": [
          "https://spoontab.com",
          "https://www.spoontab.com"
        ],
        "AllowedScopes": [
          "openid",
          "profile",
          "tenancy",
          "IdentityServerApi",
          "roles",
          "menu.read",
          "menu.write",
          "catalog.inventory.read",
          "catalog.inventory.write",
          "order.read",
          "order.write",
          "payment.read",
          "payment.charge",
          "payment.refund"
        ],
        "AlwaysIncludeUserClaimsInIdToken": true
      },
      {
        "ClientId": "spoontab-diner",
        "ClientName": "Spoontab Diner Ordering",
        "AllowedGrantTypes": [
          "password"
        ],
        "RequireClientSecret": false,
        "AllowOfflineAccess": true,
        "AllowedCorsOrigins": [
          "https://spoontab.com",
          "https://www.spoontab.com"
        ],
        "AllowedScopes": [
          "openid",
          "profile",
          "diner",
          "payment.read"
        ],
        "AlwaysIncludeUserClaimsInIdToken": true
      },
      {
        "ClientId": "spoontab-demo-admin",
        "ClientName": "Spoontab Admin Demo",
        "AllowedGrantTypes": [
          "demo_admin"
        ],
        "RequireClientSecret": false,
        "AllowOfflineAccess": false,
        "AllowedCorsOrigins": [
          "https://spoontab.com",
          "https://www.spoontab.com"
        ],
        "AllowedScopes": [
          "openid",
          "profile",
          "tenancy",
          "roles",
          "IdentityServerApi",
          "menu.read",
          "menu.write",
          "catalog.inventory.read",
          "catalog.inventory.write",
          "order.read",
          "order.write",
          "payment.read",
          "payment.charge",
          "payment.refund"
        ],
        "AlwaysIncludeUserClaimsInIdToken": true
      }
    ]
  }
}
