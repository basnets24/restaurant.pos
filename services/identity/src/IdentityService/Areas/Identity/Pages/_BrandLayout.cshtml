@*
  Custom brand layout for Identity Area, aligned with frontend tokens.
*@
@using IdentityService.Common.Settings
@inject IConfiguration Configuration
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Spoontab</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;0,700;1,500&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/Identity/css/brand.css" asp-append-version="true" />
</head>
<body>
<div class="auth-shell">
    <div class="brand-pane">
        <div class="brand-inner">
            @{
                // A page can override this (the logout confirmation page's fallback sets it
                // to the frontend's post-logout-callback URL, which both leaves the app and
                // finishes the sign-out round trip cleanly). Every other page - Login,
                // Register, ... - has no reason for anything more specific than "take me back
                // to the app", so default to the frontend's own origin, looked up the same way
                // as Logout's fallback (by ClientId, not array position).
                var homeUrl = ViewData["HomeUrl"] as string;
                if (string.IsNullOrEmpty(homeUrl))
                {
                    var settings = Configuration.GetSection("IdentityServerSettings").Get<IdentityServerSettings>();
                    homeUrl = settings?.Clients
                        .FirstOrDefault(c => c.ClientId == "frontend")?
                        .AllowedCorsOrigins?
                        .FirstOrDefault();
                }
            }
            @if (!string.IsNullOrEmpty(homeUrl))
            {
                <a href="@homeUrl" class="brand-link">
                    <partial name="_BrandMark" />
                </a>
            }
            else
            {
                <partial name="_BrandMark" />
            }
            <p class="brand-sub">One system for orders, kitchen, staff, and sales.</p>
        </div>
    </div>
    <main class="auth-pane">
        <div class="card">
            @RenderBody()
        </div>
        <script src="~/lib/jquery/dist/jquery.js"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </main>
</div>
</body>
</html>

