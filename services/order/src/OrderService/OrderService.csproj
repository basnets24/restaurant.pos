<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Common.Library" Version="1.0.23" />
        <!-- Pinned below the rest of the MassTransit 8.5.1 family deliberately:
             8.5.0+ requires Microsoft.EntityFrameworkCore.Relational 9.0.1, which
             conflicts with this codebase's EF Core 8.0.19/Npgsql 8.0.11 stack
             (Npgsql 8.0.11's NpgsqlHistoryRepository is compiled against EF Core 8's
             ABI - resolving to EF 9 at runtime throws MissingMethodException on
             get_LockReleaseBehavior). 8.4.0 is the last version still on EF Core 8. -->
        <PackageReference Include="MassTransit.EntityFrameworkCore" Version="8.4.0" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.11" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.19">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    </ItemGroup>

    <!-- TODO(diner-ordering): flip back to <PackageReference Include="Messaging.Contracts" Version="1.0.7" />
         at merge. 1.0.7 (PaymentRequested.CustomerId) only publishes on a push to dev/main, so
         this branch consumes it as a project reference.
         Checked 2026-08-05 against the flat-container index: the feed holds up to 1.0.6, so
         flipping now would not restore. The bump is real (1.0.6 -> 1.0.7), so
         publish-messaging-contracts.yml will not silently no-op on skip-duplicate the way it
         would have on an unchanged version - but confirm the version is on the feed after
         merging before flipping.
         Check it with the version index, not `dotnet package search`: GitHub's NuGet search
         index lags badly and reported 1.0.4 as newest while 1.0.6 was long published.
           curl -u <user>:$GH_PAT https://nuget.pkg.github.com/basnets24/messaging.contracts/index.json -->
    <ItemGroup>
        <ProjectReference Include="..\..\..\..\shared\messaging.contracts\Messaging.Contracts.csproj" />
    </ItemGroup>

</Project>
