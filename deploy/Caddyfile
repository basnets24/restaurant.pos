# Subdomain-per-service routing. Caddy handles Let's Encrypt HTTPS automatically
# for each site block below, provided DNS A records for all 5 subdomains point at
# this VM and 80/443 are reachable (see deploy/README.md).
#
# reverse_proxy upgrades WebSocket connections automatically — no extra config
# needed for order's SignalR floor hub.

app.{$DOMAIN} {
	reverse_proxy frontend:80
}

identity.{$DOMAIN} {
	reverse_proxy identity:5265
}

catalog.{$DOMAIN} {
	reverse_proxy catalog:5062
}

order.{$DOMAIN} {
	reverse_proxy order:5236
}

payment.{$DOMAIN} {
	reverse_proxy payment:5238
}
