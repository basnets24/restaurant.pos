# Copy to .env and fill in real values: cp .env.example .env
# .env is gitignored — never commit real secrets.
#
# scripts/dev.sh loads this file and exports every value here into the
# environment, so it drives both `infra/docker-compose.yml` (variable
# substitution) and the .NET services (ASP.NET Core's env var config
# provider reads FOO__BAR as configuration section "FOO:BAR").

# GitHub Packages (NuGet) — token needs read:packages scope
GH_OWNER=your-github-username-or-org
GH_PAT=your_github_pat

# Postgres — used by infra/docker-compose.yml and by identity/tenant services
# (scripts/dev.sh derives PostgresSettings__Password from this automatically)
POSTGRES_PASSWORD=change-me

# Identity service seed admin user
IdentitySettings__AdminUserPassword=change-me

# Stripe (payment-service) — use a Stripe test-mode key, or leave the
# placeholder if you're not exercising payment flows locally
StripeSettings__SecretKey=sk_test_placeholder
